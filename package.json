{
  "name": "@buildproven/keel",
  "version": "0.2.0",
  "description": "A deterministic quality gate for AI coding agents that also picks the model: tests first and locked, cheapest model that pays off first, escalate only on gate failure.",
  "keywords": [
    "ai",
    "coding-agent",
    "claude-code",
    "codex",
    "quality-gate",
    "tdd",
    "model-routing",
    "linear",
    "ci"
  ],
  "homepage": "https://github.com/buildproven/keel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildproven/keel.git"
  },
  "bugs": {
    "url": "https://github.com/buildproven/keel/issues"
  },
  "author": "Brett Stark",
  "license": "MIT",
  "type": "module",
  "bin": {
    "keel": "bin/keel.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "LINEAR_API_KEY= PATH=\"$PWD/test/bin:$PATH\" node --test --test-concurrency=4 --test-timeout=120000 --test-force-exit test/*.test.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "gate": "node bin/keel.js gate --base origin/main"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
